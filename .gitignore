# Public demo inputs and reference records are curated; runtime results stay local.
demos/**/reproduced/
demos/**/paper/
# This curated research source is shipped; generated paper outputs stay local.
!demos/collatz-research/reproduce/paper/
demos/collatz-research/reproduce/paper/*
!demos/collatz-research/reproduce/paper/main.tex
demos/**/reproduce/submission/

# Local-only notes and generated distributions; public maintenance code stays tracked.
/.local/
/dist/
/build/

# Real interaction-derived contribution events belong to the user workspace.
/planning/contributions.jsonl

# Raw compiler diagnostics may contain local filesystem paths.
research/**/paper/*.compile.txt
research/**/paper/*.log
