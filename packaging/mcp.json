{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "praxis-tools": {
      "type": "stdio",
      "command": "uv",
      "args": ["run", "--locked", "--project", "${PLUGIN_ROOT}/skills/praxis", "python", "-m", "scripts.mcp_server"],
      "cwd": "${PLUGIN_ROOT}/skills/praxis"
    },
    "arxiv": {
      "type": "stdio",
      "command": "uvx",
      "args": ["arxiv-mcp-server==0.8.1", "--storage-path", "${PLUGIN_DATA}/arxiv-papers"]
    }
  }
}
